#!/usr/bin/env python3
"""
Compare closed pull-requests of a GitHub repo with the PR numbers that appear
in its changelog file (``doc/changes.rst`` by default).

Features added
--------------
* ``--after N`` - only list PRs whose number is greater than *N*.
* ``--verbose`` - emit changelog-ready blocks (reST or Markdown, matching the
    changelog's own format) ready to be pasted into the changelog. Each block
    contains a bullet with the PR title and the reference link.
* ``--changelog-path`` - check a changelog file other than ``doc/changes.rst``,
    e.g. ``CHANGES.md`` or ``CHANGELOG.md``. The format (reST vs Markdown) is
    inferred from the file extension unless overridden with ``--format``.

Usage
-----
        python compare_closed_prs.py REPO_URL [--token TOKEN] [--after N]
                                              [--verbose] [--output FILE]
                                              [--changelog-path PATH]

* ``REPO_URL`` - e.g. ``desispec`` or ``https://github.com/desihub/desispec``.
* ``--token`` - optional personal-access token (avoids rate-limit).
* ``--after`` - only show PRs with a number > N.
* ``--verbose`` - produce changelog entries instead of a plain number list.
* ``--output`` - write the result to a file; otherwise prints to stdout.
* ``--changelog-path`` - path (relative to repo root) of the changelog file
    to check, e.g. ``CHANGES.md``. Default: ``doc/changes.rst``.
* ``--format`` - force ``rst`` or ``md`` parsing/output instead of inferring
    it from ``--changelog-path``'s extension.
* ``--debug`` - start IPython prompt at end instead of exiting

Written by LBL CBorg Coder AI with prompts from Stephen Bailey
"""

import argparse
import re
import sys
from pathlib import Path
from typing import Set
from zoneinfo import ZoneInfo  # Requires Python 3.9+

from desida.github import parse_repo_url, github_get, get_merged_prs, get_tags_with_dates, get_pr_title

# ----------------------------------------------------------------------
# Constants / helpers
# ----------------------------------------------------------------------
GITHUB_API = "https://api.github.com"
RAW_CONTENT = "https://raw.githubusercontent.com"
PER_PAGE = 100  # max permitted by GitHub
DEFAULT_CHANGELOG_PATH = "doc/changes.rst"


def detect_format(changelog_path):
    """Infer changelog format from its file extension.

    Args:
        changelog_path (str): Path to the changelog file, e.g. "CHANGES.md".

    Returns:
        str: "md" for Markdown, "rst" for everything else (default).
    """
    suffix = Path(changelog_path).suffix.lower()
    return "md" if suffix in (".md", ".markdown") else "rst"


def fetch_changes_file(owner, repo, changelog_path, token=None):
    """Download a changelog file from the repo main branch.

    Args:
        owner (str): GitHub org or user name, e.g. "desihub".
        repo (str): GitHub repository name, e.g. "desispec".
        changelog_path (str): Path to the changelog file within the repo,
            e.g. "doc/changes.rst" or "CHANGES.md".
        token (str or None): Optional GitHub token.

    Returns:
        str: The contents of the changelog file.

    Raises:
        requests.HTTPError: If the GitHub request fails.
        RuntimeError: If rate limiting or retries fail in GitHub helper.
    """
    raw_url = f"{RAW_CONTENT}/{owner}/{repo}/main/{changelog_path}"
    return github_get(raw_url, token=token).text


def group_prs_by_next_tag(prs, tags):
    """Group PR numbers by the next tag after their merge date.

    Args:
        prs (dict[int, datetime]): Mapping of PR number to merge datetime.
        tags (list[tuple[str, datetime]]): Tag name and datetime tuples in order.

    Returns:
        dict[str, list[int]]: Mapping of tag name to PR numbers. PRs with no
            later tag are grouped under the "NO_TAG" key.
    """
    grouped: dict[str, list[int]] = {}
    for pr_num, merged_dt in prs.items():
        tag_name = "NO_TAG"
        for name, tag_dt in tags:
            if tag_dt > merged_dt:
                tag_name = name
                break
        grouped.setdefault(tag_name, []).append(pr_num)
    return grouped


# ----------------------------------------------------------------------
# Parsing changelog PR references. Two formats are supported:
#
# reST hyperlink targets (e.g. doc/changes.rst):
#   .. _`PR #864`: https://github.com/desihub/desitarget/pull/864
#   .. _`#225`: https://github.com/desihub/desiutil/pull/225
#
# Markdown inline links (e.g. CHANGES.md, CHANGELOG.md):
#   PR [#86](https://github.com/desihub/specex/pull/86)
# ----------------------------------------------------------------------

_RST_LINE_RE = re.compile(
    r"""^\s*\.\.\s+_`[^`]+`:\s+https?://github\.com/"""
    r"""(?P<owner>[^/]+)/(?P<repo>[^/]+)/pull/(?P<num>\d+)\s*$"""
)

_MD_LINK_RE = re.compile(
    r"""\[#\d+\]\(https?://github\.com/"""
    r"""(?P<owner>[^/]+)/(?P<repo>[^/]+)/pull/(?P<num>\d+)\)"""
)


def parse_pr_numbers_from_changes(content, expected_owner, expected_repo, fmt="rst"):
    """Extract PR numbers from GitHub links in changelog text.

    Args:
        content (str): Full text of the changelog file.
        expected_owner (str): Expected GitHub org or user, e.g. "desihub".
        expected_repo (str): Expected repo name, e.g. "desispec".
        fmt (str): "rst" for reST hyperlink targets, "md" for Markdown
            inline links.

    Returns:
        set[int]: PR numbers referenced in the file.
    """
    found: Set[int] = set()
    if fmt == "md":
        for m in _MD_LINK_RE.finditer(content):
            if m.group("owner") == expected_owner and m.group("repo") == expected_repo:
                found.add(int(m.group("num")))
        return found

    for line in content.splitlines():
        m = _RST_LINE_RE.match(line.rstrip())
        if m and m.group("owner") == expected_owner and m.group("repo") == expected_repo:
            found.add(int(m.group("num")))
    return found


# ----------------------------------------------------------------------
# Main script wrapper
# ----------------------------------------------------------------------
def main():
    p = argparse.ArgumentParser(
        description="List closed PRs of a GitHub repo that are NOT mentioned in its doc/changes.rst.",
        epilog="""Without a token, GitHub API rate limits mean you can only query a few URLs.
For the --token option, generate a classic token at https://github.com/settings/tokens with
no additional scope options selected.""",
    )

    p.add_argument("repo_url",
                   help="Repo name (e.g. desispec) or full URL (e.g. https://github.com/desihub/desispec)")
    p.add_argument("-t", "--token", help="GitHub personal access token (optional).")
    p.add_argument("--after", type=int, default=None,
                   help="Only show PRs with number greater than this value.")
    p.add_argument("--verbose", action="store_true",
                   help="Output changelog entries (reST or Markdown) ready for the changelog file.")
    p.add_argument("-o", "--output", type=Path, default=None,
                   help="Write result to this file; otherwise print to stdout.")
    p.add_argument("-c", "--changelog-path", default=DEFAULT_CHANGELOG_PATH,
                   help=f"Path (relative to repo root) of the changelog file to check, "
                        f"e.g. CHANGES.md. Default: {DEFAULT_CHANGELOG_PATH}")
    p.add_argument("--format", choices=("rst", "md"), default=None,
                   help="Force reST or Markdown parsing/output instead of inferring it "
                        "from --changelog-path's extension.")
    p.add_argument("--debug", action="store_true",
                   help="Start IPython prompt at end instead of exiting.")
    args = p.parse_args()

    fmt = args.format or detect_format(args.changelog_path)

    # ------------------------------------------------------------------
    # Resolve owner/repo
    # ------------------------------------------------------------------
    try:
        owner, repo = parse_repo_url(args.repo_url)
    except ValueError as e:
        p.error(str(e))

    # ------------------------------------------------------------------
    # Parse the changelog file
    # ------------------------------------------------------------------
    changes_text = fetch_changes_file(owner, repo, args.changelog_path, token=args.token)
    file_prs = parse_pr_numbers_from_changes(changes_text, owner, repo, fmt=fmt)
    print(f"Found {len(file_prs)} PR references in {args.changelog_path}", file=sys.stderr)

    # ------------------------------------------------------------------
    # Get all merged PR numbers from GitHub
    # ------------------------------------------------------------------
    merged_prs = get_merged_prs(owner, repo, token=args.token)      # {num: datetime}
    print(f"Retrieved {len(merged_prs)} merged PRs from GitHub", file=sys.stderr)

    # ------------------------------------------------------------------
    # Compute missing PRs and apply optional ``--after`` filter
    # ------------------------------------------------------------------
    missing_prs = {num: dt for num, dt in merged_prs.items() if num not in file_prs}
    if args.after is not None:
        missing_prs = {num: dt for num, dt in missing_prs.items() if num > args.after}
    print(f"{len(missing_prs)} merged PRs are NOT mentioned in {args.changelog_path} after filtering.",
          file=sys.stderr)

    # ------------------------------------------------------------------
    # Load tags (chronological) and group PRs by first tag after merge
    # ------------------------------------------------------------------
    tags = get_tags_with_dates(owner, repo, token=args.token)
    tag_datetimes = dict(tags)  # list[(tag,date)] -> dict[tag]=date
    grouped = group_prs_by_next_tag(missing_prs, tags)

    # ------------------------------------------------------------------
    # Produce output
    # ------------------------------------------------------------------
    out_lines: list[str] = []
    if args.verbose:
        # Verbose mode prints a ready-to-paste block in the changelog's own format.
        for tag, pr_nums in grouped.items():
            # Tag header; use Pacific Time not UTC
            if tag != 'NO_TAG':
                tagdatetime_pacific = tag_datetimes[tag].astimezone(ZoneInfo("America/Los_Angeles"))
                tagdate = tagdatetime_pacific.strftime('%Y-%m-%d')  # YEAR-MM-DD
            else:
                tagdate = 'unreleased'

            line = f"{tag} ({tagdate})"

            if fmt == "md":
                out_lines.append(f"\n## {line}\n\n")
                for num in sorted(pr_nums):
                    title = get_pr_title(owner, repo, num, token=args.token)
                    url = f"https://github.com/{owner}/{repo}/pull/{num}"
                    out_lines.append(f"* {title} (PR [#{num}]({url})).\n")
                out_lines.append("\n")
                continue

            out_lines.append(f"\n{line}\n")
            out_lines.append("-"*len(line) + "\n")

            # Descriptions
            out_lines.append("\n")
            for num in sorted(pr_nums):
                title = get_pr_title(owner, repo, num, token=args.token)
                out_lines.append(f"* {title} (PR `#{num}`_).\n")

            # PR link footnotes
            out_lines.append("\n")
            for num in sorted(pr_nums):
                out_lines.append(f".. _`#{num}`: https://github.com/{owner}/{repo}/pull/{num}\n")

            out_lines.append("\n")   # blank line before reference block

    else:
        # Plain list - grouped but still one PR per line, prefixed by tag
        for tag, pr_nums in grouped.items():
            for num in sorted(pr_nums):
                out_lines.append(f"{tag}\t{num}\n")   # tab-separated "tag   PR"

    # Write / print
    if args.output:
        args.output.write_text("".join(out_lines), encoding="utf-8")
        print(f"Wrote output to {args.output}", file=sys.stderr)
    else:
        sys.stdout.writelines(out_lines)

    # debug with IPython
    if args.debug:
        import IPython
        IPython.embed()


if __name__ == "__main__":
    main()
